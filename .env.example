# ==================================================
# PostgreSQL
# ==================================================
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_pass
POSTGRES_DB=healthcare_mart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================================================
# AI Backend: "mock" (default) or "ollama"
# ==================================================
AI_BACKEND=mock

# ==================================================
# Ollama (only needed if AI_BACKEND=ollama)
# ==================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ==================================================
# Data Generation
# ==================================================
DATA_SEED=42
NUM_PATIENTS=5000
NUM_CLINICS=15
NUM_APPOINTMENTS=20000
