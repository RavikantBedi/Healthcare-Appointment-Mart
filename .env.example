# ==================================================
# PostgreSQL
# ==================================================
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_pass
POSTGRES_DB=healthcare_mart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================================================
# AI Backend: "mock" (default), "ollama", "gemini"
# ==================================================
AI_BACKEND=mock

# ==================================================
# Ollama (only needed if AI_BACKEND=ollama)
# ==================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# ==================================================
# Google Gemini (only needed if AI_BACKEND=gemini)
# ==================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# ==================================================
# Data Generation
# ==================================================
DATA_SEED=42
NUM_PATIENTS=5000
NUM_CLINICS=15
NUM_APPOINTMENTS=20000
